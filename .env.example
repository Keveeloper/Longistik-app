# Copy to .env.local (or .env.development.local) and fill in. Only variables prefixed with VITE_ reach the app.

# Panel with the public company directory (GET /api/public/companies). Optional: by default
# `npm run dev` uses the Vite proxy (/panel-api, the panel's CORS only allows its own web)
# and builds call https://api.panel.longistik.com directly.
# Login and every other call go to the selected company's apiUrl, which comes from that list.
VITE_PANEL_API_URL=

# Dev server only: a local backend that replaces the selected company's apiUrl
# (e.g. http://localhost:3001). Builds ignore it.
VITE_COMPANY_API_URL=
