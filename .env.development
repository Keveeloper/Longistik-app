# npm run dev. VITE_APP_ENV: "test" lists only the test companies, "production" hides them (src/config/env.ts).
VITE_APP_ENV=production

# Local backend: login and every company call go here instead of the selected company's apiUrl.
# Comment it out to use the real company backends. Dev server only; builds ignore it.
VITE_COMPANY_API_URL=http://localhost:3001
